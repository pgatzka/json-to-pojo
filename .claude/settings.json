{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-fable-5-1",
  "permissions": {
    "allow": [
      "Bash(./gradlew:*)",
      "Bash(./gradlew)",
      "Bash(gradlew.bat:*)",
      "Bash(.\\gradlew.bat:*)",
      "Bash(git:*)",
      "Read(docs/**)",
      "Read(plugin/**)",
      "Read(*.gradle.kts)",
      "Read(gradle/**)",
      "Edit(docs/specs/*.md)",
      "Edit(README.md)",
      "Edit(CHANGELOG.md)",
      "Edit(.claude/**)"
    ],
    "deny": [
      "Bash(gradle:*)",
      "Bash(gradle)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push -f)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/local.properties)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-guard.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
